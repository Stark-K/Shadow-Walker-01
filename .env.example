# ---- ShadowWalker environment variables ----

# FortyGuard Temperature API (read by both the Next.js API routes and the
# FastAPI backend). NEVER hardcode this key in source files.
FORTYGUARD_API_KEY=27d164f9dcabad35c3237d7ed5a7079b
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Optional: URL of the running FastAPI backend. When set, the Next.js
# /api/route-analysis endpoint proxies to it. When unset, the Next.js app
# runs a self-contained in-process engine (OSRM + simulated/real FortyGuard
# temperatures) so the frontend works on its own.
# SHADOWWALKER_BACKEND_URL=http://localhost:8000
